{
  "name": "tightarse",
  "version": "0.0.0",
  "private": true,
  "description": "Personal and family finance aggregation over UK open banking",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "agents/*",
    "spike/*",
    "infra",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json && tsc -p infra/tsconfig.tests.json && tsc -p web/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "synth": "npm run synth -w infra",
    "deploy": "npm run deploy -w infra",
    "prepare": "git config core.hooksPath .githooks",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:mutation": "npm run test:mutation --workspaces --if-present",
    "coverage:pin": "COVERAGE_PIN=1 npm run test:coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  }
}
