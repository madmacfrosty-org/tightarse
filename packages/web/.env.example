# Copy to .env.local and fill in from the deployed stack outputs.
#
# None of these are secret: a Cognito pool id, client id, hosted-UI domain and
# API URL are public identifiers sent to every browser that loads the app. The
# pool and the JWT authoriser are what enforce access. They are kept out of git
# only because they point at one specific deployed environment.
#
#   npm run deploy   # then read the CloudFormation outputs, or:
#   aws cloudformation describe-stacks --stack-name TightarseData-dev \
#     --query 'Stacks[0].Outputs' --output table

VITE_USER_POOL_ID=eu-west-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_HOSTED_UI_DOMAIN=tightarse-dev-xxxxxx.auth.eu-west-1.amazoncognito.com
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com
