{
  "openapi": "3.0.3",
  "info": {
    "title": "Tightarse",
    "version": "v1",
    "description": "Read-only aggregation over one household's bank accounts.\n\nCompatibility: Within a major version the API may add fields, optional parameters and routes. It may not remove or rename a field, change its type or units, change whether it is required, or change what it means. Clients must ignore unrecognised fields.\n\nMoney is always an integer in minor units (pence). Sign convention: negative left the household, positive arrived — including on cards, which the provider reports from the issuer's point of view and which are normalised at the boundary."
  },
  "servers": [
    {
      "url": "{apiUrl}",
      "variables": {
        "apiUrl": {
          "default": "https://example.invalid"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A Cognito access token. The household is taken from a verified claim in the token and never from the request, so there is no tenant parameter anywhere in this document."
      }
    },
    "schemas": {
      "IsoDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date as YYYY-MM-DD"
      },
      "Count": {
        "type": "integer",
        "minimum": 0
      },
      "Provisional": {
        "type": "boolean",
        "description": "True when this is the provider's own payment type, not a category we produced"
      },
      "DateRange": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/components/schemas/IsoDate"
          },
          "to": {
            "$ref": "#/components/schemas/IsoDate"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "CategoryTotal": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "description": "Total for this category, negative for spending and positive for income, in integer minor units (pence). Divide by 100 for pounds."
          },
          "count": {
            "type": "integer",
            "description": "How many transactions contributed"
          },
          "provisional": {
            "$ref": "#/components/schemas/Provisional"
          }
        },
        "required": [
          "category",
          "total",
          "count",
          "provisional"
        ],
        "additionalProperties": false
      },
      "MonthTotal": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "description": "Month as YYYY-MM"
          },
          "income": {
            "type": "integer",
            "description": "Money that arrived this month, in integer minor units (pence). Divide by 100 for pounds."
          },
          "spend": {
            "type": "integer",
            "description": "Money that left this month, negative, in integer minor units (pence). Divide by 100 for pounds."
          },
          "net": {
            "type": "integer",
            "description": "income + spend for the month, in integer minor units (pence). Divide by 100 for pounds."
          },
          "count": {
            "type": "integer",
            "description": "How many transactions contributed"
          }
        },
        "required": [
          "month",
          "income",
          "spend",
          "net",
          "count"
        ],
        "additionalProperties": false
      },
      "TransactionView": {
        "type": "object",
        "properties": {
          "dedupKey": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "description": "ISO 8601 instant"
          },
          "amount": {
            "type": "integer",
            "description": "Negative left the household, positive arrived, in integer minor units (pence). Divide by 100 for pounds."
          },
          "currency": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "transactionType": {
            "type": "string",
            "description": "The provider's own type. Not the direction — see amount"
          },
          "providerCategory": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "setId": {
            "type": "string",
            "description": "Which rule set produced the category; `provider` where nothing did"
          }
        },
        "required": [
          "dedupKey",
          "timestamp",
          "amount",
          "currency",
          "description",
          "accountId",
          "transactionType",
          "category",
          "setId"
        ],
        "additionalProperties": false
      },
      "AccountView": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "institutionName": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "isCard": {
            "type": "boolean"
          },
          "accountType": {
            "type": "string"
          },
          "currentBalance": {
            "type": "integer",
            "description": "Balance as the provider reports it; for a card, what is owed, in integer minor units (pence). Divide by 100 for pounds."
          },
          "availableBalance": {
            "type": "integer",
            "description": "Funds available to spend, in integer minor units (pence). Divide by 100 for pounds."
          },
          "lastSyncedAt": {
            "type": "string",
            "description": "ISO 8601 instant of the last successful fetch"
          },
          "historyFrom": {
            "$ref": "#/components/schemas/IsoDate",
            "description": "Earliest date this account has data for"
          },
          "historyComplete": {
            "type": "boolean",
            "description": "False when the account existed before the earliest data we hold"
          }
        },
        "required": [
          "accountId"
        ],
        "additionalProperties": false
      },
      "Summary": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "nullable": true
          },
          "from": {
            "$ref": "#/components/schemas/IsoDate"
          },
          "to": {
            "$ref": "#/components/schemas/IsoDate"
          },
          "transactionCount": {
            "type": "integer"
          },
          "income": {
            "type": "integer",
            "description": "Money that arrived across the range, in integer minor units (pence). Divide by 100 for pounds."
          },
          "spend": {
            "type": "integer",
            "description": "Money that left across the range, negative, in integer minor units (pence). Divide by 100 for pounds."
          },
          "net": {
            "type": "integer",
            "description": "income + spend across the range, in integer minor units (pence). Divide by 100 for pounds."
          },
          "byCategory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryTotal"
            }
          },
          "byMonth": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthTotal"
            }
          },
          "internalTransfersNetted": {
            "type": "boolean"
          },
          "transferCount": {
            "type": "integer"
          },
          "transferTotal": {
            "type": "integer",
            "description": "Total moved between the household's own accounts, in integer minor units (pence). Divide by 100 for pounds."
          },
          "enrichedCount": {
            "type": "integer",
            "description": "How many transactions carry a category"
          }
        },
        "required": [
          "currency",
          "from",
          "to",
          "transactionCount",
          "income",
          "spend",
          "net",
          "byCategory",
          "byMonth",
          "internalTransfersNetted",
          "transferCount",
          "transferTotal",
          "enrichedCount"
        ],
        "additionalProperties": false
      },
      "TransactionsResponse": {
        "type": "object",
        "properties": {
          "range": {
            "$ref": "#/components/schemas/DateRange"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionView"
            }
          }
        },
        "required": [
          "range",
          "transactions"
        ],
        "additionalProperties": false
      },
      "AccountsResponse": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountView"
            }
          },
          "completeFrom": {
            "$ref": "#/components/schemas/IsoDate",
            "description": "Earliest date a household total is complete; absent when unconstrained"
          }
        },
        "required": [
          "accounts"
        ],
        "additionalProperties": false
      },
      "BalancePoint": {
        "type": "object",
        "properties": {
          "date": {
            "$ref": "#/components/schemas/IsoDate"
          },
          "net": {
            "type": "integer",
            "description": "Cash less card debt, across every account with data that day, in integer minor units (pence). Divide by 100 for pounds."
          }
        },
        "required": [
          "date",
          "net"
        ],
        "additionalProperties": false
      },
      "BalancesResponse": {
        "type": "object",
        "properties": {
          "range": {
            "$ref": "#/components/schemas/DateRange"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BalancePoint"
            }
          }
        },
        "required": [
          "range",
          "points"
        ],
        "additionalProperties": false
      },
      "CategoryChoiceView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable. What a rule names and a categorisation stores."
          },
          "label": {
            "type": "string",
            "description": "What a person reads. Freely changeable, including to match a provider's wording."
          },
          "kind": {
            "type": "string",
            "description": "spending, income or movement"
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "additionalProperties": false
      },
      "CategoriesResponse": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryChoiceView"
            },
            "description": "Live categories, by label. Retired ones are not offered: filing something new under one is what retiring it was meant to stop, and refusing afterwards is a worse conversation than not offering it."
          }
        },
        "required": [
          "categories"
        ],
        "additionalProperties": false
      },
      "CategoryTallyView": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "The category identifier the rules produce"
          },
          "transactions": {
            "$ref": "#/components/schemas/Count"
          }
        },
        "required": [
          "category",
          "transactions"
        ],
        "additionalProperties": false
      },
      "DescriptionView": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "transactions": {
            "$ref": "#/components/schemas/Count"
          },
          "outgoing": {
            "type": "integer",
            "description": "Money that left the household under this description, in integer minor units (pence). Divide by 100 for pounds."
          },
          "firstSeen": {
            "type": "string",
            "description": "Booking timestamp of the earliest sighting, ISO-8601"
          },
          "lastSeen": {
            "type": "string",
            "description": "Booking timestamp of the latest sighting, ISO-8601"
          },
          "uncategorised": {
            "type": "integer",
            "minimum": 0,
            "description": "Sightings the rules currently give no category"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryTallyView"
            },
            "description": "What the rules make of it now. More than one entry means it is categorised inconsistently."
          }
        },
        "required": [
          "description",
          "transactions",
          "outgoing",
          "firstSeen",
          "lastSeen",
          "uncategorised",
          "categories"
        ],
        "additionalProperties": false
      },
      "Cadence": {
        "type": "string",
        "enum": [
          "weekly",
          "fortnightly",
          "four-weekly",
          "monthly",
          "quarterly",
          "annual"
        ],
        "description": "The beat a repeated amount keeps"
      },
      "RecurrenceView": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "description": "The repeated amount, signed so a recurring credit stays distinguishable, in integer minor units (pence). Divide by 100 for pounds."
          },
          "cadence": {
            "$ref": "#/components/schemas/Cadence"
          },
          "transactions": {
            "$ref": "#/components/schemas/Count"
          },
          "outgoing": {
            "type": "integer",
            "description": "Money that left the household across the whole series, in integer minor units (pence). Divide by 100 for pounds."
          },
          "descriptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every description this amount arrived under. More than one is the case this exists for."
          },
          "firstSeen": {
            "type": "string"
          },
          "lastSeen": {
            "type": "string"
          },
          "uncategorised": {
            "$ref": "#/components/schemas/Count"
          }
        },
        "required": [
          "amount",
          "cadence",
          "transactions",
          "outgoing",
          "descriptions",
          "firstSeen",
          "lastSeen",
          "uncategorised"
        ],
        "additionalProperties": false
      },
      "GapView": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "transactions": {
            "$ref": "#/components/schemas/Count"
          },
          "outgoing": {
            "type": "integer",
            "description": "Money that left the household under it, in integer minor units (pence). Divide by 100 for pounds."
          }
        },
        "required": [
          "description",
          "transactions",
          "outgoing"
        ],
        "additionalProperties": false
      },
      "ConflictView": {
        "type": "object",
        "properties": {
          "setId": {
            "type": "string",
            "description": "The rule set that cannot choose"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The categories it claims at once"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Count"
            },
            "description": "Positions within the set that asserted them, which is how the fold identifies a rule"
          },
          "transactions": {
            "$ref": "#/components/schemas/Count"
          },
          "example": {
            "type": "string",
            "description": "One description it happens on, for a human deciding which rule is wrong"
          }
        },
        "required": [
          "setId",
          "categories",
          "rules",
          "transactions",
          "example"
        ],
        "additionalProperties": false
      },
      "BacklogResponse": {
        "type": "object",
        "properties": {
          "range": {
            "$ref": "#/components/schemas/DateRange"
          },
          "descriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DescriptionView"
            },
            "description": "Every distinct description, costliest first"
          },
          "recurrences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecurrenceView"
            },
            "description": "Amounts arriving on a beat, costliest first"
          },
          "gaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GapView"
            },
            "description": "What nothing matched, costliest first"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConflictView"
            },
            "description": "Where a set claims two answers at once, widest first. A conflict is a gap with a cause: the set produces nothing, so its transactions appear in `gaps` as though no rule had been written for them."
          },
          "scanned": {
            "$ref": "#/components/schemas/Count"
          }
        },
        "required": [
          "range",
          "descriptions",
          "recurrences",
          "gaps",
          "conflicts",
          "scanned"
        ],
        "additionalProperties": false
      },
      "MatcherView": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "merchant"
                ]
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "Case-insensitive regular expression matched against the description"
              }
            },
            "required": [
              "kind",
              "pattern"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "providerCategory"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "The bank's own coarse category, e.g. DIRECT_DEBIT"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "transaction"
                ]
              },
              "dedupKey": {
                "type": "string",
                "minLength": 1,
                "description": "One transaction, by its dedup key"
              }
            },
            "required": [
              "kind",
              "dedupKey"
            ],
            "additionalProperties": false
          }
        ]
      },
      "MerchantRequestView": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "description": "What was typed. Matched literally, not as a pattern."
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "term",
          "category"
        ],
        "additionalProperties": false
      },
      "TransactionsRequestView": {
        "type": "object",
        "properties": {
          "dedupKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dedupKeys",
          "category"
        ],
        "additionalProperties": false
      },
      "ContributionView": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "assert"
                ]
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "description": "Establishes a category where none was established"
              }
            },
            "required": [
              "kind",
              "category"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "refine"
                ]
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "description": "Changes a category already established in the same set. Inert if nothing was."
              }
            },
            "required": [
              "kind",
              "category"
            ],
            "additionalProperties": false
          }
        ]
      },
      "RuleView": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/MatcherView"
          },
          "contributes": {
            "$ref": "#/components/schemas/ContributionView"
          },
          "appliesTo": {
            "type": "string",
            "enum": [
              "debits",
              "credits",
              "all"
            ],
            "description": "Direction this rule applies to. Credits are excluded unless a rule says otherwise."
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "matcher",
          "contributes",
          "appliesTo"
        ],
        "additionalProperties": false
      },
      "ProposedRuleSetView": {
        "type": "object",
        "properties": {
          "setId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "The version being proposed, which must be higher than the current one"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "description": "Precedence. Lower wins: overrides -1, household 0, built-in 2, provider 3."
          },
          "authored": {
            "type": "boolean",
            "description": "Whether a human wrote it. Gates automatic approval only, never whether it may be proposed."
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleView"
            }
          }
        },
        "required": [
          "setId",
          "version",
          "name",
          "order",
          "authored",
          "rules"
        ],
        "additionalProperties": false
      },
      "ProposalRequest": {
        "type": "object",
        "properties": {
          "sets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProposedRuleSetView"
            },
            "minItems": 1,
            "description": "The rule sets as they would be. Sets left out are unchanged."
          },
          "merchant": {
            "$ref": "#/components/schemas/MerchantRequestView",
            "description": "Or: a term to categorise, from which the rule is built server-side"
          },
          "transactions": {
            "$ref": "#/components/schemas/TransactionsRequestView",
            "description": "Or: specific transactions, one rule each, at override precedence"
          },
          "because": {
            "type": "string",
            "description": "Why this is being proposed, carried onto the stored version"
          }
        },
        "additionalProperties": false
      },
      "ChangeView": {
        "type": "object",
        "properties": {
          "dedupKey": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "description": "The category before, absent when nothing matched"
          },
          "to": {
            "type": "string",
            "description": "The category after, absent when the proposal leaves it uncategorised"
          }
        },
        "required": [
          "dedupKey",
          "description"
        ],
        "additionalProperties": false
      },
      "EffectView": {
        "type": "object",
        "properties": {
          "transactions": {
            "$ref": "#/components/schemas/Count"
          },
          "outgoing": {
            "type": "integer",
            "description": "Money that left the household across this group, in integer minor units (pence). Divide by 100 for pounds."
          },
          "merchants": {
            "type": "integer",
            "minimum": 0,
            "description": "Distinct descriptions. The number that says whether a pattern has escaped."
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeView"
            },
            "description": "The transactions themselves, truncated where `truncated` says so"
          },
          "truncated": {
            "type": "boolean",
            "description": "True when `entries` holds fewer than `transactions`. Never truncated silently."
          }
        },
        "required": [
          "transactions",
          "outgoing",
          "merchants",
          "entries",
          "truncated"
        ],
        "additionalProperties": false
      },
      "IntroducedConflictView": {
        "type": "object",
        "properties": {
          "setId": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The categories the set would claim at once"
          },
          "transactions": {
            "$ref": "#/components/schemas/Count"
          },
          "example": {
            "type": "string",
            "description": "One description it would happen on"
          }
        },
        "required": [
          "setId",
          "categories",
          "transactions",
          "example"
        ],
        "additionalProperties": false
      },
      "PredictionView": {
        "type": "object",
        "properties": {
          "gained": {
            "$ref": "#/components/schemas/EffectView"
          },
          "lost": {
            "$ref": "#/components/schemas/EffectView"
          },
          "recategorised": {
            "$ref": "#/components/schemas/EffectView"
          },
          "unchanged": {
            "$ref": "#/components/schemas/EffectView"
          },
          "outranked": {
            "$ref": "#/components/schemas/EffectView"
          },
          "introducedConflicts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntroducedConflictView"
            }
          },
          "scanned": {
            "$ref": "#/components/schemas/Count"
          }
        },
        "required": [
          "gained",
          "lost",
          "recategorised",
          "unchanged",
          "outranked",
          "introducedConflicts",
          "scanned"
        ],
        "additionalProperties": false
      },
      "ProposalResponse": {
        "type": "object",
        "properties": {
          "prediction": {
            "$ref": "#/components/schemas/PredictionView"
          },
          "proposed": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "setId": {
                  "type": "string"
                },
                "version": {
                  "$ref": "#/components/schemas/Count"
                }
              },
              "required": [
                "setId",
                "version"
              ],
              "additionalProperties": false
            },
            "description": "The versions created, absent on a preview"
          },
          "applied": {
            "type": "object",
            "properties": {
              "scanned": {
                "$ref": "#/components/schemas/Count"
              },
              "unchanged": {
                "type": "integer",
                "minimum": 0,
                "description": "The rules produced what was already stored"
              },
              "appended": {
                "type": "integer",
                "minimum": 0,
                "description": "Categorisations written"
              },
              "orphaned": {
                "type": "integer",
                "minimum": 0,
                "description": "Had a category, and now no rule produces one"
              },
              "uncategorised": {
                "type": "integer",
                "minimum": 0,
                "description": "Still matched by nothing"
              },
              "conflicts": {
                "type": "integer",
                "minimum": 0,
                "description": "Sets claiming two answers at once"
              },
              "inertRefines": {
                "type": "integer",
                "minimum": 0,
                "description": "Qualifiers that matched with nothing established"
              }
            },
            "required": [
              "scanned",
              "unchanged",
              "appended",
              "orphaned",
              "uncategorised",
              "conflicts",
              "inertRefines"
            ],
            "additionalProperties": false,
            "description": "What recategorising did, absent unless it was asked for"
          }
        },
        "required": [
          "prediction"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/v1/summary": {
      "get": {
        "operationId": "summary",
        "summary": "Totals for a date range",
        "description": "Spending and income over the range, split by category and by month, with internal transfers netted out.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "First day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Last day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Totals for a date range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "The range is missing, malformed, or `from` is after `to`"
          },
          "401": {
            "description": "No bearer token, or one this API does not trust"
          },
          "403": {
            "description": "A valid token carrying no household claim"
          }
        }
      }
    },
    "/v1/transactions": {
      "get": {
        "operationId": "transactions",
        "summary": "Transactions in a date range",
        "description": "Every transaction in the range, newest first, with its category where one has been assigned. Returns the whole range: there is no pagination, so a wide range is a large response. `q` narrows it to descriptions containing that text, case-insensitively and taken literally — a search, not a promise about what any rule would match.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "First day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Last day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Narrow to descriptions containing this text. Case-insensitive, and matched literally: punctuation is not a pattern. Omit for everything in the range.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions in a date range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "The range is missing, malformed, or `from` is after `to`"
          },
          "401": {
            "description": "No bearer token, or one this API does not trust"
          },
          "403": {
            "description": "A valid token carrying no household claim"
          }
        }
      }
    },
    "/v1/balances": {
      "get": {
        "operationId": "balances",
        "summary": "Net position for every day in a range",
        "description": "One point per day: cash less card debt across the household. The range is clamped to where every account has data, because a total drawn earlier silently omits an account — for a card that means missing debt, so the figure reads high. The response states the range actually served.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "First day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Last day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Net position for every day in a range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalancesResponse"
                }
              }
            }
          },
          "400": {
            "description": "The range is missing, malformed, or `from` is after `to`"
          },
          "401": {
            "description": "No bearer token, or one this API does not trust"
          },
          "403": {
            "description": "A valid token carrying no household claim"
          }
        }
      }
    },
    "/v1/categories": {
      "get": {
        "operationId": "categories",
        "summary": "The categories a household may file something under",
        "description": "Live categories only, ordered by label. Not the categories with totals — a category nobody has spent in this year is still a category, and neither the label nor the retired flag is derivable from a summary.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The categories a household may file something under",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "The range is missing, malformed, or `from` is after `to`"
          },
          "401": {
            "description": "No bearer token, or one this API does not trust"
          },
          "403": {
            "description": "A valid token carrying no household claim"
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "operationId": "accounts",
        "summary": "The household's accounts and their balances",
        "description": "One entry per connected account. An account still being described by a sync may be missing its identity fields and its isCard flag; absent isCard means NOT YET KNOWN, not false.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The household's accounts and their balances",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsResponse"
                }
              }
            }
          },
          "400": {
            "description": "The range is missing, malformed, or `from` is after `to`"
          },
          "401": {
            "description": "No bearer token, or one this API does not trust"
          },
          "403": {
            "description": "A valid token carrying no household claim"
          }
        }
      }
    },
    "/v1/categorisation/proposals": {
      "post": {
        "operationId": "categorisationProposals",
        "summary": "Propose a change to the rules, and say what it would do",
        "description": "Computes what the proposed sets would gain, lose, recategorise, leave alone and be outranked on, along with any conflict they would introduce, then writes each set as its next version marked `proposed`. `commit` says how far to take it: computing only, writing the proposal, or writing it, accepting it and recategorising the range. The prediction is always computed here and never taken from the caller.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "First day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Last day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          },
          {
            "name": "commit",
            "in": "query",
            "required": false,
            "description": "How far to take it. `preview` computes and writes nothing; `propose` writes the version awaiting a decision; `apply` writes it, accepts it and recategorises the range. Absent means `propose`. One parameter rather than two flags, because a dry run that also applies is a combination with no meaning.",
            "schema": {
              "type": "string",
              "enum": [
                "preview",
                "propose",
                "apply"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Propose a change to the rules, and say what it would do",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalResponse"
                }
              }
            }
          },
          "400": {
            "description": "The range is missing, malformed, or `from` is after `to`"
          },
          "401": {
            "description": "No bearer token, or one this API does not trust"
          },
          "403": {
            "description": "A valid token carrying no household claim"
          }
        }
      }
    },
    "/v1/categorisation/gaps": {
      "get": {
        "operationId": "categorisationGaps",
        "summary": "What the rules do not yet cover",
        "description": "Every distinct description with what it cost and what the rules currently make of it, amounts arriving on a regular beat, and the unmatched backlog — each costliest first. Categories are derived by evaluating the rules as they stand, not read from the last application, so a gap here is a gap now. Returns the whole range: there is no pagination.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "First day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Last day included in the range",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date as YYYY-MM-DD"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What the rules do not yet cover",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklogResponse"
                }
              }
            }
          },
          "400": {
            "description": "The range is missing, malformed, or `from` is after `to`"
          },
          "401": {
            "description": "No bearer token, or one this API does not trust"
          },
          "403": {
            "description": "A valid token carrying no household claim"
          }
        }
      }
    }
  }
}
