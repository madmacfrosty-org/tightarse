{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts"
  ],
  "vitest": {
    "related": false
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": ".stryker/mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 100
  },
  "tempDirName": ".stryker-tmp"
}
