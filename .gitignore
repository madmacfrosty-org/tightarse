# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
.turbo/

# CDK
cdk.out/
cdk.context.json
*.d.ts.map

# env & secrets — nothing real should ever be committed
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/

# TrueLayer / provider artefacts
tokens.json
consent*.json

# real financial data — fixtures must be synthetic (see CONTRIBUTING)
fixtures/real/
*.ofx
*.qif
statements/

# python (if any handler ever needs it)
__pycache__/
.venv/
*.egg-info/

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# logs & coverage
*.log
coverage/
# vitest --coverage.reportsDirectory; committed once because a guarded append
# silently matched the line above and never ran.
.cov/
**/.cov/
.stryker-tmp/
.stryker/

# spike probe output — statistics only, but still not for the repo
spike/*/out/

# vite build output
web/dist/

# points at a specific deployed environment
web/.env.local

# mutation testing
.stryker/
.stryker-tmp/
reports/

# Playwright, and everything a run leaves behind
#
# First because the first run is what creates these, and they look like
# ordinary test output right up until one of them carries a screenshot of a
# ledger. Traces and screenshots record whatever was on screen; storage state
# is a live session.
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.auth/
playwright/.cache/
