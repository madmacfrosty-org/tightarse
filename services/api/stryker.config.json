{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*-cli.ts",
    "!src/run.ts"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": ".stryker/mutation.json"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 50.0
  },
  "tempDirName": ".stryker-tmp",
  "incremental": true,
  "incrementalFile": ".stryker/incremental.json",
  "vitest": {
    "related": false
  }
}
